!/.gitignore
!/CNAME
!/index.html
!/services.html
!/scouts.html
!/cafe/
!/club/
!/promo/
!/terms.html
!/book.html
!/enrol.html
!/admin.html
!/admin-v2.html
!/style.css
!/script.js
!/booking.js
!/enrol.js
!/pricing.json

# Invoicing: shared by the panel and the Cloud Function that sends invoices
!/invoice-core.js
!/invoice-core.test.mjs
!/firebase.json
!/functions/
!/functions/index.js
!/functions/package.json
!/functions/.gitignore
!/images/
!/scouts-club-logo.png
!/scouts-club-logo.jpg

# Everything else (legal docs, evidence, drafts, venvs, internal notes)
# stays local and is never committed.
